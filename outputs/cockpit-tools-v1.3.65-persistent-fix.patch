+// 429. Bridge both here until the upstream generator copies these fields
+// (upstream PR #2677).
+const localDefaultMaxAccountConcurrency = 3
+
+// localMaxAccountConcurrencyWaitMs is the reviewed upper bound for the local
+// gate's wait budget. The provider-gateway sidecar can only ever observe the
+// generator default, so for that sidecar this constant is the effective value;
+// the API-service sidecar reads the real collection and honours a smaller
+// configured value unchanged. 45000 ms keeps roughly one upstream turn of
+// headroom (measured p50 32.6 s) while removing the two-minute hang: a request
+// that exhausts the whole budget and still fails cannot have been rescued by a
+// longer wait, so shortening only removes waste.
+const localMaxAccountConcurrencyWaitMs = 45000
+
+// clampMaxAccountConcurrency bridges the generator gap: keep any positive
+// manifest value as-is, and substitute the local contract default when the
+// generator rewrote the field to zero. Remove together with the local patch
+// once the upstream generator fix ships.
+func clampMaxAccountConcurrency(m *manifest) {
+	if m == nil || m.MaxAccountConcurrency > 0 {
+		return
+	}
+	m.MaxAccountConcurrency = localDefaultMaxAccountConcurrency
+}
+
+// capAccountConcurrencyWaitMs bounds the local gate's wait budget without
+// raising a smaller configured value.
+func capAccountConcurrencyWaitMs(m *manifest) {
+	if m == nil || m.AccountConcurrencyWaitMs <= localMaxAccountConcurrencyWaitMs {
+		return
+	}
+	m.AccountConcurrencyWaitMs = localMaxAccountConcurrencyWaitMs
+}
