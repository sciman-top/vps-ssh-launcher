+package main
+
+import "testing"
+
+func TestCapAccountConcurrencyWaitMsCapsGeneratorDefault(t *testing.T) {
+	// build_provider_gateway_collection_for_profile starts from the empty
+	// collection and apply_provider_gateway_template_settings never copies the
+	// account-concurrency family, so the provider-gateway sidecar always
+	// observes the struct default 120000 ms whatever the user configured.
+	m := &manifest{AccountConcurrencyWaitMs: 120000}
+	capAccountConcurrencyWaitMs(m)
+	if m.AccountConcurrencyWaitMs != localMaxAccountConcurrencyWaitMs {
+		t.Fatalf("generator default wait was not capped: got %d", m.AccountConcurrencyWaitMs)
+	}
+}
+
+func TestCapAccountConcurrencyWaitMsKeepsSmallerValue(t *testing.T) {
+	m := &manifest{AccountConcurrencyWaitMs: 20000}
+	capAccountConcurrencyWaitMs(m)
+	if m.AccountConcurrencyWaitMs != 20000 {
+		t.Fatalf("smaller configured wait must be kept: got %d", m.AccountConcurrencyWaitMs)
+	}
+}
+
+func TestCapAccountConcurrencyWaitMsZeroStaysZero(t *testing.T) {
+	// Zero means "reject immediately instead of waiting" in the selector, so the
+	// cap must not turn a deliberate no-wait configuration into a wait.
+	m := &manifest{AccountConcurrencyWaitMs: 0}
+	capAccountConcurrencyWaitMs(m)
+	if m.AccountConcurrencyWaitMs != 0 {
+		t.Fatalf("zero wait must stay zero: got %d", m.AccountConcurrencyWaitMs)
+	}
+}
+
+func TestCapAccountConcurrencyWaitMsNilSafe(t *testing.T) {
+	capAccountConcurrencyWaitMs(nil)
+}
