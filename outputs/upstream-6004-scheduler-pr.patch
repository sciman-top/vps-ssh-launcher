+// filterModelRateLimitedModels removes a pair while its declared 6004 reset is
+// active. Ordinary model cooldowns are already removed by filterCoolingModels;
+// the precise 6004 registry must feed the same catalog boundary so the host's
+// scheduler does not offer a pair known to reject until the stated reset.
+func filterModelRateLimitedModels(uid string, models []pluginapi.ModelInfo) []pluginapi.ModelInfo {
+	uid = strings.TrimSpace(uid)
+	if uid == "" {
+		return models
+	}
+	out := make([]pluginapi.ModelInfo, 0, len(models))
+	for _, model := range models {
+		if modelRateLimitError(uid, model.ID) != nil {
+			continue
+		}
+		out = append(out, model)
+	}
+	return out
+}
