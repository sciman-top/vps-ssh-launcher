+func TestModelRateLimitFiltersCatalogUntilDeclaredReset(t *testing.T) {
+	uid := "catalog-6004-account"
+	model := "deepseek-v4.1-flash-catalog-test"
+	key := modelRateLimitKey(uid, model)
