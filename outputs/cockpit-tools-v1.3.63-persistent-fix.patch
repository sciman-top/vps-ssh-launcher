+type providerGatewayFlushObserver struct {
+	gin.ResponseWriter
+	flushed chan struct{}
+}
+
+func (w *providerGatewayFlushObserver) Flush() {
+	w.ResponseWriter.Flush()
+	select {
+	case w.flushed <- struct{}{}:
+	default:
+	}
+}
+
 func TestProviderGatewayResponsesStreamKeepsMessageIdentity(t *testing.T) {
 	gin.SetMode(gin.TestMode)
 	w := httptest.NewRecorder()
 	c, _ := gin.CreateTestContext(w)
+	flushes := make(chan struct{}, 1)
+	c.Writer = &providerGatewayFlushObserver{ResponseWriter: c.Writer, flushed: flushes}
+	reader, writer := io.Pipe()
+	defer reader.Close()
+	defer writer.Close()
 	body := strings.Join([]string{
 		`data: {"type":"response.output_item.added","output_index":0,"item":{"type":"message","id":"msg_1","content":[]}}`,
 		`data: {"type":"response.output_text.delta","item_id":"msg_1","delta":"hello "}`,
@@ -63,6 +83,33 @@ func TestProviderGatewayResponsesStreamKeepsMessageIdentity(t *testing.T) {
 		`data: {"type":"response.output_item.done","output_index":0,"item":{"type":"message","id":"msg_1","content":[{"type":"output_text","text":"hello hello "}]}}`,
 		`data: {"type":"response.completed","response":{"id":"resp_1","output":[{"type":"message","id":"msg_1","content":[{"type":"output_text","text":"hello hello "}]}]}}`,
 	}, "\n\n") + "\n\n"
-	(&relayServer{}).writeProviderGatewayResponsesStream(c, strings.NewReader(body), false)
+	parts := strings.SplitN(body, "\n\n", 2)
+	done := make(chan struct{})
+	go func() {
+		(&relayServer{}).writeProviderGatewayResponsesStream(c, reader, false)
+		close(done)
+	}()
+	if _, err := io.WriteString(writer, parts[0]+"\n\n"); err != nil {
+		t.Fatalf("write first event: %v", err)
+	}
+	select {
+	case <-flushes:
+	case <-time.After(2 * time.Second):
+		t.Fatal("Responses SSE writer did not flush the first event before EOF")
+	}
+	if got := w.Body.String(); got != parts[0]+"\n\n" {
+		t.Fatalf("first event was not visible after its flush: %q", got)
+	}
+	if _, err := io.WriteString(writer, parts[1]); err != nil {
+		t.Fatalf("write remaining events: %v", err)
+	}
+	if err := writer.Close(); err != nil {
+		t.Fatalf("close stream: %v", err)
+	}
+	select {
+	case <-done:
+	case <-time.After(2 * time.Second):
+		t.Fatal("Responses SSE writer did not finish after EOF")
+	}
 	assertProviderGatewayMessageIdentity(t, w.Body.String(), "hello hello ")
 }
