{
  "approval_defaults": {
    "high_requires_explicit_approval": true,
    "medium_write_requires_approval": true
  },
  "auto_commit_policy": {
    "enabled": true,
    "on": [
      "milestone"
    ],
    "milestone_markers": [
      "checkpoint",
      "milestone",
      "release-candidate"
    ],
    "require_all_required_gates_pass": true,
    "commit_message_template": "自动提交：{repo_id} 里程碑 {milestone} 门禁通过 {timestamp}"
  },
  "branch_policy": {
    "allow_direct_push": false,
    "default_branch": "main",
    "working_branch_prefix": "governed/"
  },
  "build_commands": [
    {
      "command": "python -m compileall -q ssh_tool.py auto_install.py test_ssh_tool.py test_auto_install.py test_scripts.py test_integration_real_ssh.py",
      "id": "build",
      "required": true
    }
  ],
  "compatibility_signals": [
    {
      "capability": "native_attach",
      "degrade_to": "advisory",
      "reason": "native adapter capability has not been detected during attachment",
      "status": "unsupported"
    }
  ],
  "contract_commands": [
    {
      "command": "python -m unittest -q",
      "id": "contract",
      "required": true
    }
  ],
  "delivery_format": {
    "include_patch": true,
    "include_pr_body": true,
    "summary_template": "default"
  },
  "display_name": "vps-ssh-launcher",
  "invariant_commands": [
    {
      "command": "python -m pip check",
      "id": "pip-check",
      "required": true
    },
    {
      "command": "python -m pip_audit -r requirements.txt",
      "id": "dependency-audit",
      "required": true
    }
  ],
  "lint_commands": [
    {
      "command": "python -m ruff check .",
      "id": "ruff",
      "required": true
    },
    {
      "command": "python -m ruff format --check .",
      "id": "format",
      "required": true
    },
    {
      "command": "python -m bandit -q -r ssh_tool.py auto_install.py",
      "id": "bandit",
      "required": true
    },
    {
      "command": "python -m vulture ssh_tool.py auto_install.py test_ssh_tool.py test_auto_install.py test_scripts.py test_integration_real_ssh.py --min-confidence 80",
      "id": "vulture",
      "required": true
    }
  ],
  "path_policies": {
    "blocked": [
      ".git/**"
    ],
    "read_allow": [
      "**/*"
    ],
    "write_allow": [
      "**/*"
    ]
  },
  "primary_language": "python",
  "repo_id": "vps-ssh-launcher",
  "repo_root_locator": {
    "kind": "local_path",
    "value": "."
  },
  "required_entrypoint_policy": {
    "current_mode": "targeted_enforced",
    "target_mode": "repo_wide_enforced",
    "canonical_entrypoints": [
      "runtime-flow",
      "runtime-flow-preset"
    ],
    "allow_direct_entrypoints": [
      "run-governed-task.status",
      "session-bridge.inspect_status",
      "session-bridge.inspect_evidence",
      "session-bridge.inspect_handoff",
      "verify-repo"
    ],
    "targeted_enforcement_scopes": [
      "run_quick_gate",
      "run_full_gate",
      "verify_attachment",
      "govern_attachment_write",
      "write_request",
      "write_execute",
      "execute_attachment_write"
    ],
    "promotion_condition_ref": "docs/governance/entrypoint-promotion.md"
  },
  "risk_defaults": {
    "blocked_command_patterns": [],
    "default_write_tier": "medium"
  },
  "rollout_posture": {
    "current_mode": "observe",
    "target_mode": "advisory"
  },
  "schema_version": "1.0",
  "test_commands": [
    {
      "command": "python -m pytest -q",
      "id": "test",
      "required": true
    }
  ],
  "tool_allowlist": [
    "shell"
  ],
  "typecheck_commands": [
    {
      "command": "python -m mypy ssh_tool.py auto_install.py test_ssh_tool.py test_auto_install.py test_scripts.py test_integration_real_ssh.py",
      "id": "mypy",
      "required": true
    },
    {
      "command": "python -m pyright ssh_tool.py auto_install.py test_ssh_tool.py test_auto_install.py test_scripts.py test_integration_real_ssh.py",
      "id": "pyright",
      "required": true
    }
  ],
  "interaction_profile": {
    "default_mode": "guided",
    "term_explain_style": "definition_plus_task_role",
    "default_checklist_kind": "bugfix",
    "compaction_preference": "stage_summary",
    "summary_template": "goal-plan-changes-verification-risks",
    "handoff_teaching_notes": "Keep handoff notes short and focused on expected vs actual, repro steps, and remaining evidence gaps."
  },
  "windows_process_environment_policy": {
    "enabled": true,
    "scope": "windows_process_entrypoints",
    "required_variables": [
      "ComSpec",
      "SystemRoot",
      "WINDIR",
      "APPDATA",
      "LOCALAPPDATA",
      "PROGRAMDATA"
    ],
    "required_practice": "Normalize Windows process environment before running Python, Node, Codex, or child PowerShell from repo entrypoints.",
    "runtime_runbook": "docs/runbooks/windows-process-environment-recovery.md",
    "coding_guidance": [
      "When adding or editing a Windows PowerShell entrypoint that invokes Python, Node, Codex, or child PowerShell, initialize the Windows process environment before tool execution.",
      "If raw Python asyncio or Node CSPRNG probes fail only inside Codex or a wrapper process, treat it as process_environment_incomplete before blaming project code.",
      "Only run Winsock/IP reset after the same probes also fail in a fresh elevated PowerShell."
    ],
    "powershell_entrypoint_pattern": ". \"$PSScriptRoot\\Initialize-WindowsProcessEnvironment.ps1\"; Initialize-WindowsProcessEnvironment",
    "verification_commands": [
      "python -c \"import asyncio; print('asyncio ok')\"",
      "node -e \"console.log('node ok')\""
    ]
  }
}
