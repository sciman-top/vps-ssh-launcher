# Git converts on checkout for Windows entrypoints; Linux payloads and docs stay LF-only.
# Trailing whitespace is the CR from Windows PS heredocs; never normalize it into Linux bytes.
* text=auto

*.cmd text eol=crlf
*.ps1 text eol=crlf whitespace=-trailing-space
*.sh text eol=lf
*.conf text eol=lf

*.md text eol=lf
*.py text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.patch text eol=lf whitespace=-space-before-tab,-blank-at-eol,-blank-at-eof

*.jpg binary
*.png binary
*.zip binary
