diff --git a/plugins/workbuddy/payload.go b/plugins/workbuddy/payload.go
--- a/plugins/workbuddy/payload.go
+++ b/plugins/workbuddy/payload.go
@@ -478,9 +478,9 @@
 // scan skipped the injection whenever a client carried a system message
 // mid-history (normalizeHistory's developer→system rewrite preserves
 // position), leaving a user first message for upstream to reject. A
 // system message that is not first no longer suppresses the injection;
-// the Global-only gate is unchanged so CN traffic stays byte-identical.
+// Global and INTL require system-first; CN traffic stays byte-identical.
 func ensureSystemMessageInPlace(obj map[string]any, sa *storedAuth) bool {
-	if sa == nil || !isGlobalDomain(sa.Auth.Domain) {
+	if sa == nil || !(isGlobalDomain(sa.Auth.Domain) || isIntlDomain(sa.Auth.Domain)) {
 		return false
 	}
@@ -667,8 +667,8 @@
 	if len(payload) == 0 {
 		return payload
 	}
-	// Only inject for Global; CN doesn't need it and we minimize diff.
-	if sa == nil || !isGlobalDomain(sa.Auth.Domain) {
+	// Global and INTL require system-first; leave CN unchanged.
+	if sa == nil || !(isGlobalDomain(sa.Auth.Domain) || isIntlDomain(sa.Auth.Domain)) {
 		return payload
 	}
 	var obj map[string]any
diff --git a/plugins/workbuddy/payload_system_first_test.go b/plugins/workbuddy/payload_system_first_test.go
--- a/plugins/workbuddy/payload_system_first_test.go
+++ b/plugins/workbuddy/payload_system_first_test.go
@@ -102,10 +102,20 @@
-func TestEnsureSystemFirstIntlRealmUnchanged(t *testing.T) {
-	// Intl (codebuddy.ai) has no first-message evidence — deliberately out
-	// of scope (CHANGELOG 0.9.37); its payloads stay byte-identical.
-	sa := &storedAuth{Auth: storedTokens{Domain: "codebuddy.ai"}}
-	obj := map[string]any{"messages": []any{map[string]any{"role": "user", "content": "hi"}}}
-	if ensureSystemMessageInPlace(obj, sa) {
-		t.Fatal("Intl realm must not be touched by the Global-only injection")
+func TestEnsureSystemFirstIntlRealm(t *testing.T) {
+	for _, domain := range []string{"codebuddy.ai", "www.codebuddy.ai"} {
+		sa := &storedAuth{Auth: storedTokens{Domain: domain}}
+		obj := map[string]any{"messages": []any{map[string]any{"role": "user", "content": "hi"}}}
+		if !ensureSystemMessageInPlace(obj, sa) {
+			t.Fatalf("%s: expected system-first injection", domain)
+		}
+		if ensureSystemMessageInPlace(obj, sa) {
+			t.Fatalf("%s: second pass must not inject again", domain)
+		}
+		body := ensureSystemMessage([]byte(`{"messages":[{"role":"user","content":"hi"}]}`), sa)
+		if roles := issue20Roles(t, body); len(roles) != 2 || roles[0] != "system" || roles[1] != "user" {
+			t.Fatalf("%s: unexpected roles %v", domain, roles)
+		}
+		if string(ensureSystemMessage(body, sa)) != string(body) {
+			t.Fatalf("%s: system-first body must stay unchanged", domain)
+		}
 	}
 }
 
