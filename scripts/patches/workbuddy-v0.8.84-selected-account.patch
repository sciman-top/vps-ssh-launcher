-	picked := pickActiveAuth(cands)
+	var picked string
+	if mode == schedulerModeSelected && getActiveAuthID() != "" {
+		current := getActiveAuthID()
+		for _, candidate := range cands {
+			if candidate.ID == current && !candidate.Disabled && !candidate.Exhausted {
+				picked = current
+				break
+			}
+		}
+	} else {
+		picked = pickActiveAuth(cands)
+	}
+	if mode == schedulerModeSelected && picked != "" {
+		if _, exhausted := cachedCreditsScore(picked); exhausted {
+			picked = ""
+		}
+	}
 	if picked == "" {
+		if mode == schedulerModeSelected {
+			return rejectSelectedAuth()
+		}
 		return okEnvelope(pluginapi.SchedulerPickResponse{Handled: false})
 	}
 	return okEnvelope(pluginapi.SchedulerPickResponse{
@@ -145,3 +171,15 @@ func cachedCreditsScore(authID string) (int64, bool) {
 	}
 	return entry.credits.TotalRemain, isCreditsExhausted(entry.credits)
 }
+
+// CPA v8.0.33 consumes Reject explicitly; v7.2.30 plugin SDK lacks these
+// fields, so encode the host ABI rather than returning Handled:false (fallback).
+func rejectSelectedAuth() ([]byte, error) {
+	return okEnvelope(struct {
+		Handled      bool
+		Reject       bool
+		RejectCode   string
+		RejectReason string
+	}{true, true, "oauth_account_review_required",
+		"Selected WorkBuddy account is unavailable; automatic account fallback is disabled"})
+}
diff --git a/plugins/workbuddy/selected_mode_test.go b/plugins/workbuddy/selected_mode_test.go
new file mode 100644
index 0000000..5d01976
--- /dev/null
+++ b/plugins/workbuddy/selected_mode_test.go
@@ -0,0 +1,66 @@
+package main
+
+import (
+	"encoding/json"
+	"github.com/router-for-me/CLIProxyAPI/v7/sdk/pluginapi"
+	"testing"
+)
+
+func TestSelectedModeNeverFallsBack(t *testing.T) {
+	restore := setSchedulerMode(schedulerModeSelected)
+	defer restore()
+	defer setActiveAuthID("")
+	for _, kind := range []string{"missing", "exhausted", "disabled"} {
+		t.Run(kind, func(t *testing.T) {
+			setActiveAuthID("selected")
+			candidates := []pluginapi.SchedulerAuthCandidate{{ID: "other", Provider: providerName}}
+			if kind != "missing" {
+				c := pluginapi.SchedulerAuthCandidate{ID: "selected", Provider: providerName}
+				if kind == "disabled" {
+					c.Status = "disabled"
+				}
+				candidates = append(candidates, c)
+			}
+			if kind == "exhausted" {
+				accountCache.Store("selected", &accountCacheEntry{credits: &creditsSummary{TotalRemain: 0, TotalUsed: 100, TotalSize: 100}})
+				defer accountCache.Delete("selected")
+			}
+			raw, err := handleSchedulerPick(mustMarshal(t, pluginapi.SchedulerPickRequest{Provider: providerName, Candidates: candidates}))
+			if err != nil {
+				t.Fatal(err)
+			}
+			var envelope struct {
+				Result struct {
+					Handled, Reject    bool
+					AuthID, RejectCode string
+				}
+			}
+			if err = json.Unmarshal(raw, &envelope); err != nil {
+				t.Fatal(err)
+			}
+			if !envelope.Result.Handled || !envelope.Result.Reject || envelope.Result.AuthID != "" || envelope.Result.RejectCode != "oauth_account_review_required" {
+				t.Fatalf("must reject instead of falling back: %s", raw)
+			}
+			if getActiveAuthID() != "selected" {
+				t.Fatal("selection changed")
+			}
+			if ensureDefaultActiveAuth([]wbAccount{{AuthID: "selected", Exhausted: true}, {AuthID: "other"}}) != "selected" {
+				t.Fatal("dashboard changed selection")
+			}
+		})
+	}
+}
+func TestSelectedModeStillAllowsManualChoice(t *testing.T) {
+	restore := setSchedulerMode(schedulerModeSelected)
+	defer restore()
+	defer setActiveAuthID("")
+	setActiveAuthID("other")
+	raw, err := handleSchedulerPick(mustMarshal(t, pluginapi.SchedulerPickRequest{Provider: providerName, Candidates: []pluginapi.SchedulerAuthCandidate{{ID: "selected", Provider: providerName}, {ID: "other", Provider: providerName}}}))
+	if err != nil {
+		t.Fatal(err)
+	}
+	result := parsePickResponse(t, raw)
+	if !result.Handled || result.AuthID != "other" {
+		t.Fatalf("manual choice lost: %s", raw)
+	}
+}
