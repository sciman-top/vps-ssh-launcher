diff --git a/plugins/workbuddy/scheduler.go b/plugins/workbuddy/scheduler.go
--- a/plugins/workbuddy/scheduler.go
+++ b/plugins/workbuddy/scheduler.go
@@ -17,8 +17,9 @@
 // Legacy config values kept for configure() compatibility; pick always uses
 // panel active-auth selection now (not credit-max ranking).
 const (
-	schedulerModeOff     = "off"
-	schedulerModeCredits = "credits"
+	schedulerModeOff      = "off"
+	schedulerModeCredits  = "credits"
+	schedulerModeSelected = "selected"
 )
 
 var (
@@ -64,11 +65,13 @@
 
 	// v0.6.31: actually honor the scheduler_mode toggle. Previously the config
 	// was parsed but never read here, so "off" silently behaved like "credits".
-	if loadedSchedulerMode() != schedulerModeCredits {
+	mode := loadedSchedulerMode()
+	if mode != schedulerModeCredits && mode != schedulerModeSelected {
 		return okEnvelope(pluginapi.SchedulerPickResponse{Handled: false})
 	}
 
 	// Collect workbuddy candidates only.
+	hasWorkBuddy := req.Provider == providerName
 	var wbCandidates []pluginapi.SchedulerAuthCandidate
 	// Issue #35 (v0.9.57): a candidate whose (account, request-model) pair is
 	// cooling after an upstream failure is skipped so the plugin-side picker
@@ -80,6 +83,7 @@
 		if c.Provider != providerName {
 			continue
 		}
+		hasWorkBuddy = true
 		if candidateDisabled(c) {
 			continue
 		}
@@ -89,6 +93,9 @@
 		wbCandidates = append(wbCandidates, c)
 	}
 	if len(wbCandidates) == 0 {
+		if mode == schedulerModeSelected && hasWorkBuddy {
+			return rejectSelectedAuth()
+		}
 		return okEnvelope(pluginapi.SchedulerPickResponse{Handled: false})
 	}
 
@@ -102,8 +109,27 @@
 			Exhausted: exhausted,
 		})
 	}
-	picked := pickActiveAuth(cands)
+	var picked string
+	if mode == schedulerModeSelected && getActiveAuthID() != "" {
+		current := getActiveAuthID()
+		for _, candidate := range cands {
+			if candidate.ID == current && !candidate.Disabled && !candidate.Exhausted {
+				picked = current
+				break
+			}
+		}
+	} else {
+		picked = pickActiveAuth(cands)
+	}
+	if mode == schedulerModeSelected && picked != "" {
+		if _, exhausted := cachedCreditsScore(picked); exhausted {
+			picked = ""
+		}
+	}
 	if picked == "" {
+		if mode == schedulerModeSelected {
+			return rejectSelectedAuth()
+		}
 		return okEnvelope(pluginapi.SchedulerPickResponse{Handled: false})
 	}
 	return okEnvelope(pluginapi.SchedulerPickResponse{
@@ -145,3 +171,15 @@
 	}
 	return entry.credits.TotalRemain, isCreditsExhausted(entry.credits)
 }
+
+// CPA v8.0.33 consumes Reject explicitly; v7.2.30 plugin SDK lacks these
+// fields, so encode the host ABI rather than returning Handled:false (fallback).
+func rejectSelectedAuth() ([]byte, error) {
+	return okEnvelope(struct {
+		Handled      bool
+		Reject       bool
+		RejectCode   string
+		RejectReason string
+	}{true, true, "oauth_account_review_required",
+		"Selected WorkBuddy account is unavailable; automatic account fallback is disabled"})
+}
