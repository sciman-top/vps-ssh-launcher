+// modelSharedRateLimitError is the executor fast-fail for a credential in a
+// realm/model window shared by every Intl account. The error intentionally has
+// no StatusCode: it remains request-scoped, so the host can leave WorkBuddy and
+// try an independent provider without cooling the credential account-wide.
+func modelSharedRateLimitError(sa *storedAuth, model string) error {
+	if sa == nil || accountRegion(sa) != regionIntl {
+		return nil
+	}
+	at, ok := sharedModelRateLimitedUntil(regionIntl, model)
+	if !ok {
+		return nil
+	}
+	return fmt.Errorf(
+		"该模型处于 WorkBuddy INTL 共享上游限流中（code 6004）——该 realm 的所有凭证共享同一重置窗口，%s；不会再遍历其余 INTL 凭证，请切换其他模型或 Provider。"+
