+// schedulerCandidateRealm recognizes only positive Intl evidence. Unknown
+// candidate identifiers remain eligible; the executor-level shared fast-fail
+// still prevents an unknown Intl credential from reaching upstream.
+func schedulerCandidateRealm(c pluginapi.SchedulerAuthCandidate) string {
+	for _, key := range []string{"realm", "region", "domain"} {
+		if value, ok := c.Attributes[key]; ok {
+			value = strings.ToLower(strings.TrimSpace(value))
+			if value == regionIntl ||
+				value == "codebuddy.ai" ||
+				strings.HasSuffix(value, ".codebuddy.ai") {
+				return regionIntl
+			}
+		}
+		if value, ok := c.Metadata[key]; ok {
+			if text, ok := value.(string); ok {
+				text = strings.ToLower(strings.TrimSpace(text))
+				if text == regionIntl ||
+					text == "codebuddy.ai" ||
+					strings.HasSuffix(text, ".codebuddy.ai") {
+					return regionIntl
+				}
+			}
+		}
+	}
+	id := strings.ToLower(strings.TrimSpace(c.ID))
+	if strings.Contains(id, "workbuddy-intl-") ||
+		strings.Contains(id, "codebuddy-intl-") {
+		return regionIntl
+	}
+	return ""
+}
