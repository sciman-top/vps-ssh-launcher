+func TestIntlSharedModelRateLimitStopsSiblingCredentials(t *testing.T) {
+	model := "deepseek-v4.1-flash-shared-test"
+	key := sharedModelRateLimitKey(regionIntl, model)
+	t.Cleanup(func() {
+		wbModelRateLimits.mu.Lock()
+		delete(wbModelRateLimits.entries, key)
+		wbModelRateLimits.mu.Unlock()
+	})
+
+	reset := time.Now().Add(45 * time.Minute)
+	stamp := reset.In(wbCNZone).Format("2006-01-02 15:04:05")
+	payload := `{"code":6004,"msg":"您的使用量已超出频率限制，将在 ` + stamp +
+		` UTC+8 重置，您也可以切换其他模型继续使用。"}`
+	intl := &storedAuth{Auth: storedTokens{Domain: "www.codebuddy.ai", Region: "intl"}}
+	cn := &storedAuth{Auth: storedTokens{Domain: "www.codebuddy.cn", Region: "cn"}}
+
+	noteSharedModelRateLimitFromPayload(intl, model, http.StatusTooManyRequests, payload)
+	at, ok := sharedModelRateLimitedUntil(regionIntl, model)
+	if !ok {
+		t.Fatal("Intl 6004 must open the realm/model window")
+	}
+	if diff := at.Sub(reset.Truncate(time.Second)); diff < -2*time.Second || diff > 2*time.Second {
+		t.Fatalf("shared reset = %v, want ≈ %v", at, reset)
+	}
+	if err := modelSharedRateLimitError(intl, model); err == nil {
+		t.Fatal("Intl sibling must fast-fail in the shared window")
+	} else if strings.Contains(err.Error(), "429") {
+		t.Fatalf("shared fast-fail must stay request-level: %v", err)
+	}
+	if err := modelSharedRateLimitError(cn, model); err != nil {
+		t.Fatalf("CN must retain an independent account window, got %v", err)
+	}
+
+	cnOnlyModel := "glm-shared-test"
+	cnKey := sharedModelRateLimitKey(regionIntl, cnOnlyModel)
+	t.Cleanup(func() {
+		wbModelRateLimits.mu.Lock()
+		delete(wbModelRateLimits.entries, cnKey)
+		wbModelRateLimits.mu.Unlock()
+	})
+	noteSharedModelRateLimitFromPayload(
+		cn,
+		cnOnlyModel,
+		http.StatusTooManyRequests,
+		`{"code":6004,"msg":"limit"}`,
+	)
+	if _, ok := sharedModelRateLimitedUntil(regionIntl, cnOnlyModel); ok {
+		t.Fatal("CN 6004 must not create an Intl shared window")
+	}
+}
