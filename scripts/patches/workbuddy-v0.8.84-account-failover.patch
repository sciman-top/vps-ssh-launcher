+package main
+
+import (
+	"encoding/json"
+	"testing"
+	"time"
+	"github.com/router-for-me/CLIProxyAPI/v7/sdk/pluginapi"
+)
+
+func TestAccountFailover11128(t *testing.T) {
+	now := time.Now()
+	withFrozenCooldown(t, now)
+	defer setSchedulerMode(schedulerModeCredits)()
+	resetActiveAuth(t)
+	setActiveAuthID("failed")
+	recordUpstreamFailure("failed", nil, "deepseek-v4.1-flash", 400, `{"code":11128,"msg":"request illegal"}`)
+	if !modelIsCooling("failed", "other-model") || modelIsCooling("healthy", "deepseek-v4.1-flash") {
+		t.Fatal("only failed credential must cool across its models")
+	}
+	if got := modelCoolingUntil("failed", "other-model"); !got.Equal(now.Add(5*time.Minute)) {
+		t.Fatalf("unexpected local circuit: %v", got)
+	}
+	req := pluginapi.SchedulerPickRequest{Provider: providerName, Model: "deepseek-v4.1-flash", Candidates: []pluginapi.SchedulerAuthCandidate{
+		{ID: "failed", Provider: providerName}, {ID: "healthy", Provider: providerName},
+	}}
+	raw, err := handleSchedulerPick(mustMarshal(t, req))
+	if err != nil { t.Fatal(err) }
+	resp := parsePickResponse(t, raw)
+	if !resp.Handled || resp.AuthID != "healthy" || getActiveAuthID() != "healthy" {
+		t.Fatalf("must switch away from failed credential: %+v", resp)
+	}
+	recordUpstreamFailure("healthy", nil, req.Model, 400, `{"code":11128}`)
+	raw, err = handleSchedulerPick(mustMarshal(t, req))
+	if err != nil { t.Fatal(err) }
+	var env struct { Result struct { Handled, Reject bool; AuthID string } }
+	if err := json.Unmarshal(raw, &env); err != nil { t.Fatal(err) }
+	if !env.Result.Handled || !env.Result.Reject || env.Result.AuthID != "" {
+		t.Fatalf("all cooling must stop: %s", raw)
+	}
+	cooldownNowFn = func() time.Time { return now.Add(5*time.Minute + time.Second) }
+	raw, err = handleSchedulerPick(mustMarshal(t, req))
+	if err != nil { t.Fatal(err) }
+	if resp = parsePickResponse(t, raw); !resp.Handled || resp.AuthID != "healthy" {
+		t.Fatalf("stay on healthy selection after expiry: %+v", resp)
+	}
+}
+
+func TestAccountFailoverFramedAndNonRisk(t *testing.T) {
+	withFrozenCooldown(t, time.Now())
+	recordUpstreamFailure("framed", nil, "m", 0, `workbuddy upstream error: {"code":11128}`)
+	if !modelIsCooling("framed", "other") { t.Fatal("framed rejection must cool account") }
+	recordUpstreamFailure("prose", nil, "m", 200, `{"code":11128}`)
+	if modelIsCooling("prose", "m") { t.Fatal("success must not trigger") }
+	recordUpstreamFailure("format", nil, "m", 400, `{"code":11115}`)
+	if modelIsCooling("format", "m") { t.Fatal("unrelated error must not trigger") }
+}
+
+func TestAccountFailoverThreeAccounts(t *testing.T) {
+	withFrozenCooldown(t, time.Now())
+	defer setSchedulerMode(schedulerModeCredits)()
+	resetActiveAuth(t)
+	setActiveAuthID("first")
+	recordUpstreamFailure("first", nil, "m", 400, `{"code":11128}`)
+	recordUpstreamFailure("second", nil, "m", 400, `{"code":11128}`)
+	raw, err := handleSchedulerPick(mustMarshal(t, pluginapi.SchedulerPickRequest{Provider: providerName, Model: "m", Candidates: []pluginapi.SchedulerAuthCandidate{
+		{ID: "first", Provider: providerName}, {ID: "second", Provider: providerName}, {ID: "third", Provider: providerName},
+	}}))
+	if err != nil { t.Fatal(err) }
+	if got := parsePickResponse(t, raw); !got.Handled || got.AuthID != "third" { t.Fatalf("third account must remain eligible: %+v", got) }
+}
diff --git a/plugins/workbuddy/cooldown.go b/plugins/workbuddy/cooldown.go
index 50100fe..fa0da40 100644
--- a/plugins/workbuddy/cooldown.go
+++ b/plugins/workbuddy/cooldown.go
@@ -173,15 +173,19 @@ func modelCoolingUntil(authID, model string) time.Time {
 	key := modelCooldownKey{AuthID: authID, ModelID: model}
 	cooldownMu.Lock()
 	defer cooldownMu.Unlock()
-	entry, ok := cooldownTable[key]
-	if !ok {
-		return time.Time{}
-	}
-	if !entry.Until.After(now) {
-		delete(cooldownTable, key)
-		return time.Time{}
+	until := time.Time{}
+	// Credential-wide rejections also block every model on this account.
+	// Keep the longest active deadline, including model-specific holds.
+	for _, candidate := range []modelCooldownKey{key, {AuthID: authID, ModelID: "*"}} {
+		if entry, ok := cooldownTable[candidate]; ok {
+			if !entry.Until.After(now) {
+				delete(cooldownTable, candidate)
+			} else if entry.Until.After(until) {
+				until = entry.Until
+			}
+		}
 	}
-	return entry.Until
+	return until
 }
 
 // modelIsCooling reports whether the pair is cooling right now.
@@ -300,6 +304,13 @@ func recordUpstreamFailure(authID string, sa *storedAuth, model string, status i
 	if authID == "" || model == "" {
 		return
 	}
+	// This function receives upstream failures, never ordinary output.
+	if isChannelRiskControl(status, body) ||
+		(status == 0 && isInStreamErrorFailure(body) && isChannelRiskControl(400, body)) {
+		markModelCooldownUntil(authID, "*", cooldownReason("channel_rejected"),
+			cooldownNowFn().Add(5*time.Minute))
+		return
+	}
 	// 6004 model-scoped rate limit: model_ratelimit.go owns it with the
 	// upstream-declared reset; a second, blunter table entry would only
 	// fight the precise one.
