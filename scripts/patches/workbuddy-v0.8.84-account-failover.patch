diff --git a/plugins/workbuddy/scheduler.go b/plugins/workbuddy/scheduler.go
index 023b8d0..1980a2e 100644
--- a/plugins/workbuddy/scheduler.go
+++ b/plugins/workbuddy/scheduler.go
@@ -93,6 +93,9 @@ func handleSchedulerPick(raw []byte) ([]byte, error) {
 		wbCandidates = append(wbCandidates, c)
 	}
 	if len(wbCandidates) == 0 {
+		if mode == schedulerModeCredits && hasWorkBuddy {
+			return rejectAutomaticPool()
+		}
 		if mode == schedulerModeSelected && hasWorkBuddy {
 			return rejectSelectedAuth()
 		}
@@ -132,6 +135,11 @@ func handleSchedulerPick(raw []byte) ([]byte, error) {
 		}
 		return okEnvelope(pluginapi.SchedulerPickResponse{Handled: false})
 	}
+	if mode == schedulerModeCredits {
+		if _, exhausted := cachedCreditsScore(picked); exhausted {
+			return rejectAutomaticPool()
+		}
+	}
 	return okEnvelope(pluginapi.SchedulerPickResponse{
 		AuthID:  picked,
 		Handled: true,
@@ -183,3 +191,13 @@ func rejectSelectedAuth() ([]byte, error) {
 	}{true, true, "oauth_account_review_required",
 		"Selected WorkBuddy account is unavailable; automatic account fallback is disabled"})
 }
+
+func rejectAutomaticPool() ([]byte, error) {
+	return okEnvelope(struct {
+		Handled      bool
+		Reject       bool
+		RejectCode   string
+		RejectReason string
+	}{true, true, "oauth_pool_unavailable",
+		"No eligible WorkBuddy account; cooling or exhausted accounts are not retried"})
+}
