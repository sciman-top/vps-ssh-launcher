+func TestSchedulerPickSkipsRecordedUIDWindowForCanonicalAuthID(t *testing.T) {
+	resetActiveAuth(t)
+	uid := "canonical-rate-limited-account"
+	authID := "auth/workbuddy-intl-" + uid + ".json"
+	model := "deepseek-v4.1-flash-6004-scheduler-test"
+	key := modelRateLimitKey(uid, model)
+	wbModelRateLimits.mu.Lock()
+	delete(wbModelRateLimits.entries, key)
+	wbModelRateLimits.mu.Unlock()
+	noteModelRateLimit(uid, model, time.Now().Add(time.Hour))
+	t.Cleanup(func() {
+		wbModelRateLimits.mu.Lock()
+		delete(wbModelRateLimits.entries, key)
+		wbModelRateLimits.mu.Unlock()
+	})
+	raw, err := handleSchedulerPick(mustMarshal(t, pluginapi.SchedulerPickRequest{
+		Provider: providerName,
+		Model:    model,
+		Candidates: []pluginapi.SchedulerAuthCandidate{
+			{ID: authID, Provider: providerName, Status: "active"},
+			{ID: "auth/workbuddy-intl-" + uid + "-sibling.json", Provider: providerName, Status: "active"},
+		},
+	}))
+	if err != nil {
+		t.Fatalf("pick: %v", err)
+	}
+	resp := parsePickResponse(t, raw)
+	if !resp.Handled || resp.AuthID != "auth/workbuddy-intl-"+uid+"-sibling.json" {
+		t.Fatalf("scheduler must skip only the recorded UID pair, got %+v", resp)
+	}
+}
