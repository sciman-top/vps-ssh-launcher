From: vps-ssh-launcher maintainers
Subject: [PATCH] Resolve recorded WorkBuddy 6004 windows for scheduler and catalog

Source: mmqz/cpa-multi-plugins v0.8.94 / 6dccdfb9f0cef599324c420a24057ea605970789 (MIT).

Scheduler auth IDs and stored account UIDs are different keys. Resolve only the
canonical file-derived identity for the recorded (credential, model) 6004
window, then filter it in scheduler.pick and model.for_auth as well as the
executor. Unknown and longer-suffix IDs must remain independently eligible;
do not turn this into a realm-wide limit. No retry or reset changes.

Use git apply --check, then gofmt, go vet, and go test before building.

diff --git a/plugins/workbuddy/canonical_auth_key.go b/plugins/workbuddy/canonical_auth_key.go
new file mode 100644
--- /dev/null
+++ b/plugins/workbuddy/canonical_auth_key.go
@@ -0,0 +1,22 @@
+package main
+
+import "strings"
+
+// credentialUIDFromAuthID recognizes only a canonical file-derived ID.
+// A noncanonical or longer-suffix ID returns an empty UID and must never
+// acquire a different account's recorded 6004 window.
+func credentialUIDFromAuthID(authID string) string {
+	authID = strings.TrimSpace(authID)
+	for _, prefix := range []string{
+		"auth/workbuddy-intl-", "auth/workbuddy-",
+		"workbuddy-intl-", "workbuddy-",
+	} {
+		if strings.HasPrefix(authID, prefix) && strings.HasSuffix(authID, ".json") {
+			uid := strings.TrimSuffix(strings.TrimPrefix(authID, prefix), ".json")
+			if uid != "" && !strings.ContainsAny(uid, "/\\") {
+				return uid
+			}
+		}
+	}
+	return ""
+}
diff --git a/plugins/workbuddy/model_ratelimit.go b/plugins/workbuddy/model_ratelimit.go
--- a/plugins/workbuddy/model_ratelimit.go
+++ b/plugins/workbuddy/model_ratelimit.go
@@ -158,6 +158,17 @@
 	return strings.TrimSpace(uid) + "\x1f" + strings.ToLower(strings.TrimSpace(model))
 }
 
+func modelRateLimitErrorFor(authID, uid, model string) error {
+	for _, candidate := range []string{authID, credentialUIDFromAuthID(authID), uid} {
+		if strings.TrimSpace(candidate) != "" {
+			if err := modelRateLimitError(candidate, model); err != nil {
+				return err
+			}
+		}
+	}
+	return nil
+}
