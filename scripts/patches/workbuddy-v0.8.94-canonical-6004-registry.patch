+func TestModelRateLimitResolvesOnlyCanonicalAuthId(t *testing.T) {
+	uid := "canonical-6004-test"
+	model := "canonical-6004-model"
+	key := modelRateLimitKey(uid, model)
+	t.Cleanup(func() {
+		wbModelRateLimits.mu.Lock()
+		delete(wbModelRateLimits.entries, key)
+		wbModelRateLimits.mu.Unlock()
+	})
+	noteModelRateLimit(uid, model, time.Now().Add(time.Hour))
+	for _, authID := range []string{"auth/workbuddy-intl-" + uid + ".json", "workbuddy-intl-" + uid + ".json", uid} {
+		if modelRateLimitErrorFor(authID, "", model) == nil {
+			t.Fatalf("canonical auth ID %q must resolve the UID window", authID)
+		}
+	}
+	if modelRateLimitErrorFor("auth/workbuddy-intl-other.json", "other-uid", model) != nil {
+		t.Fatal("another credential must retain an independent window")
+	}
+	if modelRateLimitErrorFor("auth/workbuddy-intl-"+uid+"-sibling.json", "", model) != nil {
+		t.Fatal("a longer suffix must not acquire another account's window")
+	}
+}
